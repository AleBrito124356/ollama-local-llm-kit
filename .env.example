# Copy this file to .env and adjust as needed:  cp .env.example .env
# Everything works fully local with the defaults below — no key required.
# The kit reads .env from the current directory, or else from the repo root.

# Which backend to use: "ollama" (local, default) or "nim" (free NVIDIA cloud).
# This single variable is the one-flag switch: flip it and the same code runs
# against a cloud model with no other change.
LLM_BACKEND=ollama

# NVIDIA NIM API key — only needed when LLM_BACKEND=nim.
# Get a free key at https://build.nvidia.com (sign in, pick a model, "Get API Key").
# No credit card, ~2 minutes. The key starts with "nvapi-". Uncomment and paste it:
# NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXX
# (The placeholder above is rejected with a sign-up hint if you forget to replace it.)

# Cloud chat model used when LLM_BACKEND=nim (any model id from build.nvidia.com).
NIM_MODEL=meta/llama-3.3-70b-instruct

# Point the "nim" backend at a self-hosted NIM container instead of NVIDIA's
# hosted API. A self-hosted container does not need NVIDIA_API_KEY.
# NIM_BASE_URL=http://localhost:8000/v1

# Where the local Ollama server listens. Change host/port if you run it elsewhere.
# "host:port" and "0.0.0.0:port" (Ollama's own format) are accepted too.
OLLAMA_HOST=http://localhost:11434

# Optional per-role local model overrides. Leave unset to use the kit defaults.
# OLLAMA_CHAT_MODEL=llama3.1:8b
# OLLAMA_CHAT_SMALL_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_VISION_MODEL=llava:7b

# Optional cloud model overrides for the non-chat roles.
# NIM_CHAT_SMALL_MODEL=meta/llama-3.1-8b-instruct
# NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
